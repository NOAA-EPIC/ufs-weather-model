<workflow realtime="F" scheduler="slurm" taskthrottle="10">
  <cycledef name="forecast" start="2025010100" end="2025123100" interval="06:00:00" />
  <log>&amp;LOG;/workflow.log</log>
  <task name="compile_ng-godas_datm_cdeps_intel">
    <command>&amp;PATHRT;/run_compile.sh &amp;PATHRT; &amp;RUNDIR_ROOT; "-DAPP=NG-GODAS" ng-godas_datm_cdeps_intel 2&gt;&amp;1
| tee &amp;LOG;/compile_ng-godas_datm_cdeps_intel.log</command>
