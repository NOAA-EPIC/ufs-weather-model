    <account>GFS-DEV</account>
    <queue>batch</queue>
    <partition>orion</partition>
    <nodes>1</nodes>
    <walltime>00:30:00</walltime>
    <join>&amp;RUNDIR_ROOT;/compile_{key}.log</join>
    <maxtries>2</maxtries>
    </task>
