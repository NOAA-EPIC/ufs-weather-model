      <command>&amp;PATHRT;/run_test.sh &amp;PATHRT; &amp;RUNDIR_ROOT; $TEST ng-godas_datm_cdeps_intel intel 2&gt;&amp;1 | tee
&amp;LOG;/run_ng-godas_datm_cdeps_intel.log</command>
      <dependency>
        <taskdep task="compile_ng-godas_datm_cdeps_intel" />
        </dependency>
      <jobname>datm_cdeps_control_cfsr</jobname>
      <account>GFS-DEV</account>
      <queue>batch</queue>
      <partition>orion</partition>
      <nodes>1</nodes>
      <walltime>00:30:00</walltime>
      <join>&amp;RUNDIR_ROOT;/ng-godas_datm_cdeps_intel.log</join>
      <maxtries>2</maxtries>
      <turnoff>wcoss2</turnoff>
      <project>daily</project>
      </task>
    <var name="TEST" value="datm_cdeps_ciceC_cfsr" />
